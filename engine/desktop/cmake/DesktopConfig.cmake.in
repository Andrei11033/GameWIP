@PACKAGE_INIT@

set(Desktop_APPLICATION_MANIFEST "@PACKAGE_CMAKE_INSTALL_DATADIR@/Desktop/desktop_application.manifest")
set(Desktop_APPLICATION_RC_TEMPLATE "@PACKAGE_CMAKE_INSTALL_DATADIR@/Desktop/desktop_application.rc.in")

include(CMakeFindDependencyMacro)
find_dependency(IO @PROJECT_VERSION@ EXACT CONFIG)
find_dependency(FileSystem @PROJECT_VERSION@ EXACT CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/DesktopTargets.cmake")

if(WIN32)
    if(NOT EXISTS "${Desktop_APPLICATION_MANIFEST}" OR NOT EXISTS "${Desktop_APPLICATION_RC_TEMPLATE}")
        message(FATAL_ERROR "Desktop application-manifest package resources are missing.")
    endif()
    enable_language(RC)
    set(DESKTOP_INTERNAL_APPLICATION_MANIFEST "${Desktop_APPLICATION_MANIFEST}")
    set(Desktop_APPLICATION_RC "${CMAKE_CURRENT_BINARY_DIR}/desktop_application.rc")
    configure_file("${Desktop_APPLICATION_RC_TEMPLATE}" "${Desktop_APPLICATION_RC}" @ONLY)
    set_property(TARGET GameWIP::Desktop APPEND PROPERTY INTERFACE_SOURCES "${Desktop_APPLICATION_RC}")
endif()
