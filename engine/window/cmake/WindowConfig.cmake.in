@PACKAGE_INIT@

set(Window_APPLICATION_MANIFEST "@PACKAGE_CMAKE_INSTALL_DATADIR@/Window/window_application.manifest")
set(Window_APPLICATION_RC_TEMPLATE "@PACKAGE_CMAKE_INSTALL_DATADIR@/Window/window_application.rc.in")

include(CMakeFindDependencyMacro)
find_dependency(IO @PROJECT_VERSION@ EXACT CONFIG)
find_dependency(FileSystem @PROJECT_VERSION@ EXACT CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/WindowTargets.cmake")

if(WIN32)
    if(NOT EXISTS "${Window_APPLICATION_MANIFEST}" OR NOT EXISTS "${Window_APPLICATION_RC_TEMPLATE}")
        message(FATAL_ERROR "Window application-manifest package resources are missing.")
    endif()
    enable_language(RC)
    set(WINDOW_INTERNAL_APPLICATION_MANIFEST "${Window_APPLICATION_MANIFEST}")
    set(Window_APPLICATION_RC "${CMAKE_CURRENT_BINARY_DIR}/window_application.rc")
    configure_file("${Window_APPLICATION_RC_TEMPLATE}" "${Window_APPLICATION_RC}" @ONLY)
    set_property(TARGET GameWIP::Window APPEND PROPERTY INTERFACE_SOURCES "${Window_APPLICATION_RC}")
endif()
