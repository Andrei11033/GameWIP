PROJECT_NAME           = "Foundation and Tool Libraries"
PROJECT_BRIEF          = "FileSystem, IO, Terminal, Logger, Assert, and TestSupport"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
OUTPUT_DIRECTORY       = "@LIBRARY_DOXYGEN_OUTPUT_DIR@"

# Generated by cmake/LibraryDoxygen.cmake as one physical line.
# Only explicit public headers and Markdown guide pages are registered.
# Do not make Doxygen crawl the repo tree from here.
INPUT                  = @LIBRARY_DOXYGEN_INPUTS@

RECURSIVE              = NO
FILE_PATTERNS          = *.h *.hpp *.md
EXCLUDE                = "@CMAKE_CURRENT_SOURCE_DIR@/build" "@CMAKE_CURRENT_SOURCE_DIR@/build-*" "@CMAKE_CURRENT_BINARY_DIR@" "@CMAKE_CURRENT_SOURCE_DIR@/external" "@CMAKE_CURRENT_SOURCE_DIR@/.git" "@CMAKE_CURRENT_SOURCE_DIR@/.tracy" "@CMAKE_CURRENT_SOURCE_DIR@/.vscode" "@CMAKE_CURRENT_SOURCE_DIR@/logs" "@CMAKE_CURRENT_SOURCE_DIR@/tools/logger/platform" "@CMAKE_CURRENT_SOURCE_DIR@/tools/debug/assert/platform"
EXCLUDE_PATTERNS       = */build/* */build-*/* */external/* */.git/* */.tracy/* */.vscode/* */logs/* */cmake/* */internal/*_test_hooks.h */docs/doxygen/html/*

USE_MDFILE_AS_MAINPAGE = "@LIBRARY_DOXYGEN_MAINPAGE@"
WARN_LOGFILE           = "@LIBRARY_DOXYGEN_WARNING_LOG@"

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
HTML_EXTRA_STYLESHEET  = "@CMAKE_CURRENT_SOURCE_DIR@/docs/doxygen/custom.css"
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES

# Keep the docs target quick and deterministic. Graph/PlantUML-style output can
# be enabled later behind a separate option if the project needs diagrams.
HAVE_DOT               = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
CLASS_GRAPH            = NO
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
GRAPHICAL_HIERARCHY    = NO
DIRECTORY_GRAPH        = NO
PLANTUML_JAR_PATH      =
PLANTUML_CFG_FILE      =
PLANTUML_INCLUDE_PATH  =

MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO

INLINE_SIMPLE_STRUCTS  = YES
SORT_MEMBER_DOCS       = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = "@CMAKE_CURRENT_SOURCE_DIR@"

ALIASES += thread_safety="<dl class=\"section note\"><dt>Thread safety</dt><dd>"
ALIASES += endthread_safety="</dd></dl>"
ALIASES += performance="<dl class=\"section note\"><dt>Performance</dt><dd>"
ALIASES += endperformance="</dd></dl>"
ALIASES += lifecycle="<dl class=\"section note\"><dt>Lifecycle</dt><dd>"
ALIASES += endlifecycle="</dd></dl>"
ALIASES += contract="<dl class=\"section note\"><dt>Contract</dt><dd>"
ALIASES += endcontract="</dd></dl>"
ALIASES += blocking="<dl class=\"section note\"><dt>Blocking behavior</dt><dd>"
ALIASES += endblocking="</dd></dl>"
ALIASES += failure="<dl class=\"section warning\"><dt>Failure behavior</dt><dd>"
ALIASES += endfailure="</dd></dl>"
ALIASES += ui="<dl class=\"section note\"><dt>UI behavior</dt><dd>"
ALIASES += endui="</dd></dl>"
ALIASES += test_only="<dl class=\"section warning\"><dt>Test-only API</dt><dd>"
ALIASES += endtest_only="</dd></dl>"
