{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GameWIP build targets",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defaultTarget", "targets"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "defaultTarget": {
      "type": "string",
      "minLength": 1
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/target"
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "platform", "architecture", "backend", "toolchain", "compilerTriple", "processor"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "toolchain": {
          "type": "string",
          "minLength": 1
        },
        "compilerTriple": {
          "type": "string",
          "minLength": 1
        },
        "processor": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
