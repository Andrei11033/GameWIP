{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Andrei11033/GameWIP/schemas/project.schema.json",
  "title": "GameWIP project configuration",
  "description": "Repository identity and build-local helper storage paths.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "defaultBranch", "storage", "managedEnvironment"],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Configuration contract version."
    },
    "repository": {
      "const": "Andrei11033/GameWIP",
      "description": "Canonical GitHub owner and repository."
    },
    "defaultBranch": {
      "const": "master",
      "description": "Canonical integration branch."
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "cache", "state", "temp", "runs"],
      "properties": {
        "root": {
          "const": "build/gamewip",
          "description": "Default local helper root; GAMEWIP_STORAGE_ROOT may override it beneath build/."
        },
        "cache": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
          "description": "Cache directory relative to the helper root."
        },
        "state": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
          "description": "State directory relative to the helper root."
        },
        "temp": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
          "description": "Temporary directory relative to the helper root."
        },
        "runs": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
          "description": "Retained run directory relative to the helper root."
        }
      }
    },
    "managedEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["msys2Root", "gameWipToolsRoot"],
      "properties": {
        "msys2Root": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
          "description": "MSYS2 root relative to the helper root."
        },
        "gameWipToolsRoot": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
          "description": "Managed tool root relative to the helper root."
        }
      }
    }
  }
}
