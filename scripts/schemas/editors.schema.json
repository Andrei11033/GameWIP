{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GameWIP editor registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "default", "options"],
  "properties": {
    "schemaVersion": { "const": 1, "description": "Registry schema version." },
    "default": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "options": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/editor" } }
  },
  "$defs": {
    "editor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "id", "name", "recommended", "handler", "package"],
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 1 },
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "recommended": { "type": "boolean" },
        "handler": { "enum": ["vscode", "visual-studio"] },
        "package": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "extensions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    }
  }
}
