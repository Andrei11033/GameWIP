{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Andrei11033/GameWIP/schemas/option.schema.json",
  "title": "GameWIP command-line option",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "description"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$"
    },
    "kind": {
      "enum": ["switch", "string", "integer", "choice", "string-list"]
    },
    "valueName": {
      "type": "string",
      "minLength": 1
    },
    "choices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "global": {
      "type": "boolean"
    }
  }
}
