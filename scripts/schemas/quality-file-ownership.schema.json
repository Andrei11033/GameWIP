{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GameWIP maintained-file quality ownership",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "excludePrefixes", "historicalPrefixes", "binaryExtensions", "policies"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "excludePrefixes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "historicalPrefixes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "binaryExtensions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^\\." } },
    "policies": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/policy" } }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "formatter", "checks", "allowTrailingWhitespace"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "exactNames": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "extensions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^\\." } },
        "suffixes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "formatter": { "type": ["string", "null"] },
        "noFormatterReason": { "type": "string", "minLength": 1 },
        "checks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "allowTrailingWhitespace": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "formatter": { "type": "null" } }, "required": ["formatter"] },
          "then": { "required": ["noFormatterReason"] }
        },
        {
          "anyOf": [{ "required": ["exactNames"] }, { "required": ["extensions"] }, { "required": ["suffixes"] }]
        }
      ]
    }
  }
}
