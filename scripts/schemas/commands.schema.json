{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Andrei11033/GameWIP/schemas/commands.schema.json",
  "title": "GameWIP command registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "actions",
    "menus",
    "defaultConfigurePreset",
    "defaultBuildPreset",
    "defaultTestPreset",
    "defaultModule",
    "defaultStressCount",
    "defaultStressParallel",
    "formatting",
    "unicode",
    "benchmarkProfiles",
    "manualWorkflows",
    "modules",
    "projectCommands",
    "bundles"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "actions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/action" } },
    "menus": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/menu" } },
    "defaultConfigurePreset": { "type": "string", "minLength": 1 },
    "defaultBuildPreset": { "type": "string", "minLength": 1 },
    "defaultTestPreset": { "type": "string", "minLength": 1 },
    "defaultModule": { "type": "string", "minLength": 1 },
    "defaultStressCount": { "type": "integer", "minimum": 1 },
    "defaultStressParallel": { "type": "integer", "minimum": 1 },
    "formatting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configPath", "sourceRoots"],
      "properties": {
        "configPath": { "type": "string", "minLength": 1 },
        "sourceRoots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "unicode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "generator", "generatedHeader", "ucdUrlTemplate", "requiredFiles"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "generator": { "type": "string", "minLength": 1 },
        "generatedHeader": { "type": "string", "minLength": 1 },
        "ucdUrlTemplate": { "type": "string", "minLength": 1 },
        "requiredFiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "benchmarkProfiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/benchmarkProfile" } },
    "manualWorkflows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/manualWorkflow" } },
    "modules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
    "projectCommands": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/projectCommand" } },
    "bundles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/bundle" } }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "group", "visible", "network", "mutation", "risk"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "group": { "enum": ["navigation", "development", "validation", "quality", "tools", "repository", "maintenance"] },
        "key": { "type": "string", "minLength": 1, "maxLength": 1 },
        "visible": { "type": "boolean" },
        "network": { "type": "boolean" },
        "mutation": { "enum": ["none", "local", "tracked", "machine", "remote", "conditional"] },
        "risk": { "enum": ["read-only", "local", "tracked", "machine", "destructive", "remote"] }
      }
    },
    "menu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "prompt", "exitLabel", "items"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "exitLabel": { "enum": ["Back", "Exit"] },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/menuItem" } }
      }
    },
    "menuItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "handler"],
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "handler": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
      }
    },
    "benchmarkProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "repetitions", "minTime", "aggregatesOnly"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "repetitions": { "type": "integer", "minimum": 1 },
        "minTime": { "type": "string", "pattern": "^(?:[0-9]+x|[0-9]+(?:\\.[0-9]+)?s)$" },
        "aggregatesOnly": { "type": "boolean" },
        "randomInterleaving": { "type": "boolean" }
      }
    },
    "manualWorkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "file", "safety"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.yml$" },
        "safety": { "enum": ["check", "dry-run", "write", "finalize", "deploy"] }
      }
    },
    "projectCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "buildPreset", "executable", "arguments", "useWorkspaceTemp", "acceptsExtraArgs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "buildPreset": { "type": "string", "minLength": 1 },
        "executable": { "type": "string", "minLength": 1 },
        "alternateExecutable": { "type": "string", "minLength": 1 },
        "arguments": { "type": "array", "items": { "type": "string" } },
        "useWorkspaceTemp": { "type": "boolean" },
        "acceptsExtraArgs": { "type": "boolean" }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "steps"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "freshBuildTrees": { "type": "boolean" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/bundleStep" } }
      }
    },
    "bundleStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["Configure", "Build", "BuildTarget", "CTest", "ProjectCommand", "Benchmark", "Bundle"] },
        "preset": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "bundle": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 },
        "filter": { "type": "string" },
        "useWorkspaceTemp": { "type": "boolean" },
        "buildIfMissing": { "type": "boolean" },
        "arguments": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
