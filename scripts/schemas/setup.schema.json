{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GameWIP setup registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "actions",
    "bootstrapToolIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Registry schema version."
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      },
      "minItems": 1
    },
    "bootstrapToolIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "machineChanges"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "machineChanges": {
          "type": "boolean"
        }
      }
    }
  }
}
