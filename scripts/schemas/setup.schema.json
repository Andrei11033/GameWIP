{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GameWIP setup registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "actions", "options", "actionOptions", "bootstrapToolIds"],
  "properties": {
    "schemaVersion": { "const": 1, "description": "Setup-registry contract version." },
    "actions": {
      "type": "array",
      "minItems": 1,
      "description": "Interactive and explicit setup actions exposed by Windows.ps1.",
      "items": { "$ref": "#/$defs/action" }
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "description": "Public command-line options exposed by the setup helper.",
      "items": { "$ref": "#/$defs/option" }
    },
    "actionOptions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      },
      "description": "Action-specific options layered over the common options."
    },
    "bootstrapToolIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Project-tool IDs required before setup can perform its provider stages.",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "risk", "network", "mutation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
        "key": { "type": "string", "minLength": 1, "maxLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "risk": { "enum": ["read-only", "local", "machine", "destructive"] },
        "network": { "type": "boolean" },
        "mutation": { "enum": ["none", "local", "machine", "destructive"] }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
        "kind": { "enum": ["switch", "string", "integer", "choice", "string-list"] },
        "valueName": { "type": "string", "minLength": 1 },
        "choices": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "description": { "type": "string", "minLength": 1 },
        "global": { "type": "boolean" }
      }
    }
  }
}
