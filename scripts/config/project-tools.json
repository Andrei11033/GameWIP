    {
      "id": "tracy",
      "name": "Tracy",
      "category": "profiling",
      "provider": {
        "kind": "gitSubmodule",
        "path": "external/tracy"
      },
      "versionPolicy": "informational",
      "detection": {
        "command": "git",
        "versionArguments": [
          "-C",
          "external/tracy",
          "rev-parse",
          "HEAD"
        ],
        "versionPattern": "([0-9a-f]{40})"
      },
      "capabilities": {
        "detectInstalled": true,
        "checkLatest": false,
        "update": false
      },
      "references": [
        {
          "path": ".gitmodules",
          "kind": "path"
        }
      ]
