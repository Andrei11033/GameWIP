{
  "schemaVersion": 1,
  "tools": [
    {
      "id": "msys2",
      "name": "MSYS2",
      "category": "environment",
      "provider": {
        "kind": "winget",
        "package": "MSYS2.MSYS2",
        "managedPath": "usr/bin/bash.exe",
        "installArguments": [
          "--override",
          "install --confirm-command --root {msys2Root}"
        ]
      },
      "versionPolicy": "managed",
      "detection": {
        "command": "bash",
        "versionArguments": [
          "--version"
        ],
        "versionPattern": "version ([0-9.]+)"
      },
      "capabilities": {
        "detectInstalled": true,
        "checkLatest": false,
        "update": false
      },
      "references": []
    },
    {
      "id": "msys2-git",
      "name": "MSYS2 Git",
      "category": "source-control",
