        "command": "gamewip",
        "versionArguments": [
          "unicode",
          "-UnicodeAction",
          "status"
        ],
        "versionPattern": "Unicode ([0-9.]+)",
        "repositoryPath": "gamewip.bat"
      },
      "capabilities": {
        "detectInstalled": true,
        "checkLatest": false,
        "update": false
      },
      "references": [
        {
          "path": "foundation/unicode/tools/generate_unicode_data.py",
