        "archiveName": "actionlint_{version}_{os}_{arch}.{extension}",
        "assets": {
          "linux-amd64": {
            "archive": "actionlint_1.7.12_linux_x86_64.tar.gz",
            "sha256": "8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8"
          },
          "windows-amd64": {
            "archive": "actionlint_1.7.12_windows_amd64.zip",
            "sha256": "6e7241b51e6817ea6a047693d8e6fed13b31819c9a0dd6c5a726e1592d22f6e9"
          }
        },
        "releaseTag": "v1.7.12"
      },
      "versionPolicy": "exact",
      "requiredVersion": "1.7.12",
      "detection": {
        "command": "actionlint",
        "versionArguments": [
          "-version"
        ],
        "versionPattern": "([0-9.]+)"
