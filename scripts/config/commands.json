{
  "schemaVersion": 1,
  "options": [
    {
      "id": "Preview",
      "kind": "switch",
      "description": "Show the operation plan without applying its requested changes.",
      "global": true
    },
    {
      "id": "NonInteractive",
      "kind": "switch",
      "description": "Never prompt for input.",
      "global": true
    },
    {
      "id": "Yes",
      "kind": "switch",
      "description": "Grant consent after the operation plan is known.",
      "global": true
    },
    {
      "id": "Json",
      "kind": "switch",
      "description": "Emit the final operation result as JSON.",
      "global": true
    },
    {
      "id": "Quiet",
      "kind": "switch",
      "description": "Reduce normal output while retaining logs and receipt data.",
      "global": true
    },
    {
      "id": "NoColor",
      "kind": "switch",
      "description": "Use plain terminal presentation.",
      "global": true
    },
    {
      "id": "OutputMode",
      "kind": "choice",
      "valueName": "mode",
      "choices": ["Summary", "Stream", "LogOnly"],
      "description": "Select native-process presentation policy.",
      "global": true
    },
    {
      "id": "Verbose",
      "kind": "switch",
      "description": "Use PowerShell's common parameter for detailed progress.",
      "global": true
    },
    {
      "id": "Debug",
      "kind": "switch",
      "description": "Use PowerShell's common parameter for diagnostic debugging.",
      "global": true
    },
    {
      "id": "PythonPath",
      "kind": "string",
      "valueName": "path",
      "description": "Override the Python interpreter used by supported maintenance operations."
    },
    {
      "id": "PythonHostPath",
      "kind": "string",
      "valueName": "path",
      "description": "Override the native Python host used to provision managed Python tools."
    },
    {
      "id": "ClangFormatPath",
      "kind": "string",
      "valueName": "path",
      "description": "Override the clang-format executable used by formatting and quality operations."
    },
    {
      "id": "UnicodeDataPath",
      "kind": "string",
      "valueName": "path",
      "description": "Override the pinned Unicode source-data directory."
    },
    {
      "id": "RefreshUnicodeData",
      "kind": "switch",
      "description": "Refresh official Unicode source data before verification or regeneration."
    },
    {
      "id": "WorkflowKind",
      "kind": "choice",
      "valueName": "kind",
      "choices": ["all", "issue", "pull_request"],
      "description": "Limit project-reconciliation workflow scope."
    },
    {
      "id": "ItemNumber",
      "kind": "integer",
      "valueName": "number",
      "description": "Select the issue or pull request for a narrowed workflow."
    },
    {
      "id": "ReleaseCommit",
      "kind": "string",
      "valueName": "sha",
      "description": "Supply the exact release-finalization commit."
    },
    {
      "id": "BenchmarkProfile",
      "kind": "choice",
      "valueName": "profile",
      "choices": ["quick", "standard", "stable"],
      "description": "Select benchmark measurement policy."
    },
    {
      "id": "NameFilter",
      "kind": "string",
      "valueName": "regex",
      "description": "Select benchmark names with a regular expression."
    },
    {
      "id": "Repetitions",
      "kind": "integer",
      "valueName": "count",
      "description": "Override the benchmark repetition count."
    },
    {
      "id": "MinimumTime",
      "kind": "string",
      "valueName": "time",
      "description": "Override benchmark minimum measurement time."
    },
    {
      "id": "OutputPath",
      "kind": "string",
      "valueName": "path",
      "description": "Write benchmark results or comparisons to this path."
    },
    {
      "id": "OutputFormat",
      "kind": "choice",
      "valueName": "format",
      "choices": ["json", "csv"],
      "description": "Select benchmark result format."
    },
    {
      "id": "AggregatesOnly",
      "kind": "switch",
      "description": "Retain and display aggregate benchmark rows only."
    },
    {
      "id": "BaselinePath",
      "kind": "string",
      "valueName": "path",
      "description": "Select the baseline benchmark JSON for comparison."
    },
    {
      "id": "CandidatePath",
      "kind": "string",
      "valueName": "path",
      "description": "Select the candidate benchmark JSON for comparison."
    },
    {
      "id": "RunCount",
      "kind": "integer",
      "valueName": "count",
      "description": "Select the number of stress-validation runs."
    },
    {
      "id": "WorkerCount",
      "kind": "integer",
      "valueName": "count",
      "description": "Select the maximum number of concurrent stress workers."
    },
    {
      "id": "PassThroughArgs",
      "kind": "string-list",
      "valueName": "arguments",
      "description": "Forward additional arguments to the selected validation or project executable."
    },
    {
      "id": "SkipBuild",
      "kind": "switch",
      "description": "Do not build prerequisites automatically; require usable existing build state."
    },
    {
      "id": "CleanBuild",
      "kind": "switch",
      "description": "Recreate the selected known preset build tree before configuring or building."
    },
    {
      "id": "Offline",
      "kind": "switch",
      "description": "Require cached dependency sources and disallow dependency downloads."
    },
    {
      "id": "FailFast",
      "kind": "switch",
      "description": "Stop launching new work or quality checks after the first failure."
    },
    {
      "id": "ChangedOnly",
      "kind": "switch",
      "description": "Restrict supported quality work to ordinary changed maintained files."
    },
    {
      "id": "FailOnFindings",
      "kind": "switch",
      "description": "Fail optional hygiene audits when they produce proven findings."
    },
    {
      "id": "UseCallerTemp",
      "kind": "switch",
      "description": "Keep the caller's TEMP/TMP instead of using operation-owned helper temporary storage."
    }
  ],
  "actionOptions": {
    "ready": ["PythonPath", "PythonHostPath", "ClangFormatPath"],
    "git": [],
    "workflow": ["WorkflowKind", "ItemNumber", "ReleaseCommit"],
    "unicode": ["PythonPath", "UnicodeDataPath", "RefreshUnicodeData"],
    "format": ["ClangFormatPath"],
    "quality": ["PythonPath", "ClangFormatPath", "FailFast", "ChangedOnly", "FailOnFindings"],
    "tool": ["PythonPath", "PythonHostPath"],
    "links": ["PythonPath"],
    "deps": [],
    "config": ["CleanBuild", "Offline"],
    "build": ["CleanBuild", "Offline"],
    "test": ["SkipBuild", "CleanBuild"],
    "module": ["SkipBuild", "PassThroughArgs"],
    "wizard": ["SkipBuild"],
    "stress": ["RunCount", "WorkerCount", "PassThroughArgs", "SkipBuild", "FailFast", "UseCallerTemp"],
    "run": ["SkipBuild", "PassThroughArgs"],
    "bundle": ["SkipBuild", "CleanBuild"],
    "doc": ["PythonPath"],
    "analyze": [],
    "cov": [],
    "asan": [],
    "ubsan": [],
    "bench": [
      "BenchmarkProfile",
      "NameFilter",
      "Repetitions",
      "MinimumTime",
      "OutputPath",
      "OutputFormat",
      "AggregatesOnly",
      "BaselinePath",
      "CandidatePath",
      "SkipBuild",
      "PassThroughArgs"
    ],
    "history": [],
    "list": [],
    "help": [],
    "menu": []
  },
