          "handler": "unicode-status"
        },
        {
          "key": "2",
          "label": "Verify generated data",
          "handler": "unicode-verify"
        },
        {
          "key": "3",
          "label": "Regenerate tracked data",
          "handler": "unicode-regenerate"
        }
      ]
    },
    {
      "id": "run-history",
      "title": "Run history",
      "prompt": "Choose an action:",
      "exitLabel": "Back",
      "items": [
        {
          "key": "1",
          "label": "List",
          "handler": "history-list"
        },
        {
          "key": "2",
          "label": "Show",
          "handler": "history-show"
        },
        {
          "key": "3",
          "label": "Clean",
          "handler": "history-clean"
        }
      ]
    }
  ],
  "formatting": {
    "sourceRoots": ["foundation", "tools", "engine", "game"],
    "configPath": ".clang-format"
  },
  "defaultStressCount": 32,
  "modules": [
    {
      "id": "assert"
    },
    {
      "id": "base"
    },
    {
      "id": "desktop",
      "builderOptions": [
        {
          "id": "manual-suite",
          "title": "Desktop manual suite",
          "description": "Narrow enabled Desktop manual validation to one workflow.",
          "kind": "choice",
          "arguments": ["--desktop-manual-suite={value}"],
          "choices": [
            "all",
            "lifecycle",
            "multiple-windows",
            "custom-chrome",
            "layered-pointer",
            "dpi",
            "cursor",
            "child-surface",
            "files-shell",
            "dialogs",
            "drag-drop",
            "fullscreen",
            "borderless",
            "exclusive",
            "topology",
            "hdr",
            "modern"
          ],
          "default": "all",
          "omitDefault": true,
          "requiresCommon": ["manual-tests"]
        }
      ]
    },
    {
      "id": "filesystem"
    },
    {
      "id": "input"
    },
    {
      "id": "io"
    },
    {
      "id": "logger"
    },
    {
      "id": "runner"
    },
    {
      "id": "terminal"
    },
    {
      "id": "test_support"
    },
    {
      "id": "unicode"
    }
  ],
  "defaultBuildPreset": "test",
  "unicode": {
    "version": "17.0.0",
    "generatedHeader": "foundation\\unicode\\internal\\generated\\unicode_properties.h",
    "ucdUrlTemplate": "https://www.unicode.org/Public/{0}/ucd/UCD.zip",
    "requiredFiles": [
      "auxiliary\\GraphemeBreakProperty.txt",
      "DerivedCoreProperties.txt",
      "emoji\\emoji-data.txt",
      "auxiliary\\GraphemeBreakTest.txt"
    ],
    "generator": "foundation\\unicode\\tools\\generate_unicode_data.py"
  },
  "projectCommands": [
    {
      "id": "test-all",
      "executable": "build\\test\\GameWIPTests.exe",
      "useWorkspaceTemp": true,
      "buildPreset": "test",
      "name": "Run all correctness modules",
      "arguments": ["--no-test-report"],
      "acceptsExtraArgs": true
    },
    {
      "id": "benchmark-dry-run",
      "executable": "build\\benchmark\\GameWIPBenchmarks.exe",
      "useWorkspaceTemp": true,
      "buildPreset": "benchmark",
      "name": "Run benchmark registration dry run",
      "arguments": ["--benchmark_dry_run"],
      "acceptsExtraArgs": true
    },
    {
      "id": "dev-version",
      "executable": "build\\dev\\GameWIP.exe",
      "useWorkspaceTemp": false,
      "buildPreset": "dev",
      "name": "Print development executable version",
      "arguments": ["--version"],
      "acceptsExtraArgs": false
    },
    {
      "id": "release-version",
      "executable": "build\\release\\game\\GameWIP.exe",
      "alternateExecutable": "build\\release\\GameWIP.exe",
      "useWorkspaceTemp": false,
      "buildPreset": "release",
      "name": "Print release executable version",
      "arguments": ["--version"],
      "acceptsExtraArgs": false
    }
  ],
  "defaultConfigurePreset": "test",
  "defaultStressParallel": 8,
  "benchmarkProfiles": [
    {
      "aggregatesOnly": false,
      "minTime": "0.05s",
      "name": "Quick development measurement",
      "id": "quick",
      "repetitions": 1
    },
    {
      "aggregatesOnly": true,
      "minTime": "0.2s",
      "name": "Repeatable local measurement",
      "id": "standard",
      "repetitions": 5
    },
    {
      "repetitions": 10,
      "id": "stable",
      "randomInterleaving": true,
      "aggregatesOnly": true,
      "name": "Longer comparison-quality measurement",
      "minTime": "1s"
    }
  ],
  "bundles": [
