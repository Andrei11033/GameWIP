{
  "name": "gamewip-workflows",
  "displayName": "GameWIP Workflow Keybindings",
  "description": "Repository-scoped keyboard shortcuts for complete GameWIP development workflows.",
  "version": "1.7.0",
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:scripts/config/build-targets.json"
  ],
  "publisher": "gamewip",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "contributes": {
    "configuration": {
      "title": "GameWIP",
      "properties": {
        "gamewip.keybindings.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable GameWIP workflow shortcuts in this workspace."
        }
      }
    },
    "keybindings": [
      {
        "key": "alt+f5",
        "command": "workbench.action.tasks.runTask",
        "args": "GameWIP: Build Development",
        "when": "config.gamewip.keybindings.enabled"
      },
      {
        "key": "f5",
        "command": "workbench.action.tasks.runTask",
        "args": "GameWIP: Run Development",
        "when": "config.gamewip.keybindings.enabled"
      },
      {
        "key": "ctrl+f5",
        "command": "workbench.action.tasks.runTask",
        "args": "GameWIP: Run Development (Clean Build)",
        "when": "config.gamewip.keybindings.enabled"
      },
      {
        "key": "f6",
        "command": "workbench.action.tasks.runTask",
        "args": "GameWIP: Run Development With Startup Tests",
        "when": "config.gamewip.keybindings.enabled"
      },
      {
        "key": "ctrl+f6",
        "command": "workbench.action.tasks.runTask",
        "args": "GameWIP: Run Development With Startup Tests (Clean Build)",
        "when": "config.gamewip.keybindings.enabled"
      },
      {
        "key": "f7",
        "command": "workbench.action.tasks.runTask",
        "args": "GameWIP: Test",
        "when": "config.gamewip.keybindings.enabled"
      },
      {
        "key": "ctrl+f7",
        "command": "workbench.action.tasks.runTask",
        "args": "GameWIP: Test (Clean Build)",
        "when": "config.gamewip.keybindings.enabled"
      },
      {
        "key": "alt+f7",
        "command": "workbench.action.tasks.runTask",
        "args": "GameWIP: Benchmark",
        "when": "config.gamewip.keybindings.enabled"
      },
      {
        "key": "f8",
        "command": "workbench.action.tasks.runTask",
        "args": "GameWIP: Documentation",
        "when": "config.gamewip.keybindings.enabled"
      },
      {
        "key": "ctrl+f8",
        "command": "workbench.action.tasks.runTask",
        "args": "GameWIP: Documentation (Clean Build)",
        "when": "config.gamewip.keybindings.enabled"
      },
      {
        "key": "alt+f8",
        "command": "workbench.action.tasks.runTask",
        "args": "GameWIP: Analyze",
        "when": "config.gamewip.keybindings.enabled"
      },
      {
        "key": "f9",
        "command": "workbench.action.tasks.runTask",
        "args": "GameWIP: Profile",
        "when": "config.gamewip.keybindings.enabled"
      },
      {
        "key": "ctrl+f9",
        "command": "workbench.action.tasks.runTask",
        "args": "GameWIP: Profile (Clean Build)",
        "when": "config.gamewip.keybindings.enabled"
      },
      {
        "key": "alt+f9",
        "command": "workbench.action.tasks.runTask",
        "args": "GameWIP: Profile Startup Tests",
        "when": "config.gamewip.keybindings.enabled"
      },
      {
        "key": "f10",
        "command": "workbench.action.tasks.runTask",
        "args": "GameWIP: Coverage",
        "when": "config.gamewip.keybindings.enabled"
      },
      {
        "key": "f11",
        "command": "workbench.action.tasks.runTask",
        "args": "GameWIP: Address Sanitizer",
        "when": "config.gamewip.keybindings.enabled"
      },
      {
        "key": "alt+f11",
        "command": "workbench.action.tasks.runTask",
        "args": "GameWIP: Undefined Behavior Sanitizer",
        "when": "config.gamewip.keybindings.enabled"
      },
      {
        "key": "f12",
        "command": "workbench.action.tasks.runTask",
        "args": "GameWIP: Run Release",
        "when": "config.gamewip.keybindings.enabled"
      },
      {
        "key": "ctrl+f12",
        "command": "workbench.action.tasks.runTask",
        "args": "GameWIP: Run Release (Clean Build)",
        "when": "config.gamewip.keybindings.enabled"
      },
      {
        "key": "alt+f12",
        "command": "workbench.action.tasks.runTask",
        "args": "GameWIP: Build Release",
        "when": "config.gamewip.keybindings.enabled"
      }
    ]
  }
}
