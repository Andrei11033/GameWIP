# Select build targets and test modules from the CMake dependency graph.

function(gamewip_validation_collect_targets directory output_variable)
    get_property(gamewip_directory_targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    get_property(gamewip_subdirectories DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    set(gamewip_all_targets ${gamewip_directory_targets})

    foreach(gamewip_subdirectory IN LISTS gamewip_subdirectories)
        gamewip_validation_collect_targets("${gamewip_subdirectory}" gamewip_nested_targets)
        list(APPEND gamewip_all_targets ${gamewip_nested_targets})
    endforeach()

    set(${output_variable} "${gamewip_all_targets}" PARENT_SCOPE)
endfunction()

function(gamewip_validation_collect_references target output_variable)
    set(gamewip_reference_properties LINK_LIBRARIES INTERFACE_LINK_LIBRARIES MANUALLY_ADDED_DEPENDENCIES)
    set(gamewip_references)

    foreach(gamewip_property IN LISTS gamewip_reference_properties)
        get_target_property(gamewip_entries "${target}" "${gamewip_property}")

        if(NOT gamewip_entries OR gamewip_entries STREQUAL "gamewip_entries-NOTFOUND")
            continue()
        endif()

        foreach(gamewip_entry IN LISTS gamewip_entries)
            string(REGEX MATCHALL "[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)*" gamewip_tokens "${gamewip_entry}")

            foreach(gamewip_token IN LISTS gamewip_tokens)
                if(TARGET "${gamewip_token}")
                    get_target_property(gamewip_alias "${gamewip_token}" ALIASED_TARGET)
                    if(gamewip_alias)
                        list(APPEND gamewip_references "${gamewip_alias}")
                    else()
                        list(APPEND gamewip_references "${gamewip_token}")
                    endif()
                endif()
            endforeach()
        endforeach()
    endforeach()

    list(REMOVE_DUPLICATES gamewip_references)
    set(${output_variable} "${gamewip_references}" PARENT_SCOPE)
endfunction()

function(gamewip_validation_target_owns_path target changed_path output_variable)
    get_target_property(gamewip_target_directory "${target}" SOURCE_DIR)
    get_target_property(gamewip_target_sources "${target}" SOURCES)
    set(gamewip_exact_match OFF)

    foreach(gamewip_source IN LISTS gamewip_target_sources)
        if(gamewip_source MATCHES "^\\$<")
            continue()
        endif()

        if(NOT IS_ABSOLUTE "${gamewip_source}")
            cmake_path(ABSOLUTE_PATH gamewip_source BASE_DIRECTORY "${gamewip_target_directory}" NORMALIZE OUTPUT_VARIABLE gamewip_source_absolute)
        else()
            cmake_path(NORMAL_PATH gamewip_source OUTPUT_VARIABLE gamewip_source_absolute)
        endif()

        if(gamewip_source_absolute STREQUAL changed_path)
            set(gamewip_exact_match ON)
            break()
        endif()
    endforeach()

    if(gamewip_exact_match)
        set(${output_variable} EXACT PARENT_SCOPE)
        return()
    endif()

    file(RELATIVE_PATH gamewip_relative_path "${gamewip_target_directory}" "${changed_path}")
    if(IS_ABSOLUTE "${gamewip_relative_path}" OR gamewip_relative_path MATCHES "^\\.\\.")
        set(${output_variable} "" PARENT_SCOPE)
        return()
    endif()

    string(LENGTH "${gamewip_target_directory}" gamewip_directory_length)
    set(${output_variable} "${gamewip_directory_length}" PARENT_SCOPE)
endfunction()

function(gamewip_finalize_validation_scope)
    gamewip_validation_collect_targets("${PROJECT_SOURCE_DIR}" gamewip_all_targets)
    get_property(gamewip_module_targets GLOBAL PROPERTY GAMEWIP_VALIDATION_MODULE_TARGETS)
    set(gamewip_changed_paths)
    set(gamewip_manifest_provided OFF)
    set(gamewip_full_scope OFF)
    set(gamewip_full_target_scope OFF)
    set(gamewip_all_module_scope OFF)
    set(gamewip_changed_owners)
    set(gamewip_changed_cpp_files)

    if(DEFINED ENV{GAMEWIP_VALIDATION_CHANGED_FILES_PATH} AND NOT "$ENV{GAMEWIP_VALIDATION_CHANGED_FILES_PATH}" STREQUAL "")
        set(gamewip_manifest_path "$ENV{GAMEWIP_VALIDATION_CHANGED_FILES_PATH}")
        if(NOT EXISTS "${gamewip_manifest_path}")
            message(FATAL_ERROR "Validation changed-file manifest does not exist: ${gamewip_manifest_path}")
        endif()

        file(READ "${gamewip_manifest_path}" gamewip_manifest_json)
        string(JSON gamewip_changed_file_count ERROR_VARIABLE gamewip_json_error LENGTH "${gamewip_manifest_json}" changed_files)
        if(gamewip_json_error)
            message(FATAL_ERROR "Validation changed-file manifest is invalid: ${gamewip_json_error}")
        endif()

        string(JSON gamewip_full_scope GET "${gamewip_manifest_json}" full_validation)
        if(gamewip_full_scope)
            set(gamewip_full_scope ON)
            set(gamewip_full_target_scope ON)
            set(gamewip_all_module_scope ON)
        endif()

        if(gamewip_changed_file_count GREATER 0)
            math(EXPR gamewip_last_index "${gamewip_changed_file_count} - 1")
            foreach(gamewip_index RANGE 0 ${gamewip_last_index})
                string(JSON gamewip_changed_path GET "${gamewip_manifest_json}" changed_files ${gamewip_index})
                list(APPEND gamewip_changed_paths "${gamewip_changed_path}")
            endforeach()
        endif()
        set(gamewip_manifest_provided ON)
    else()
        set(gamewip_all_module_scope ON)
    endif()

    # Shared test infrastructure is needed by every module.
    foreach(gamewip_changed_path IN LISTS gamewip_changed_paths)
        string(REPLACE "\\" "/" gamewip_changed_path "${gamewip_changed_path}")
        if(
            gamewip_changed_path MATCHES "^game/validation/tests/internal/"
            OR gamewip_changed_path MATCHES "^game/validation/tests/(registry|runner)\\.(cpp|h)$"
            OR gamewip_changed_path STREQUAL "game/validation/tests/standalone_main.cpp"
        )
            set(gamewip_all_module_scope ON)
        endif()

        string(TOLOWER "${gamewip_changed_path}" gamewip_lower_path)
        if(gamewip_lower_path MATCHES "\\.(c|cc|cpp|cxx|h|hh|hpp|hxx|inl)$")
            cmake_path(ABSOLUTE_PATH gamewip_changed_path BASE_DIRECTORY "${PROJECT_SOURCE_DIR}" NORMALIZE OUTPUT_VARIABLE gamewip_changed_absolute)
            if(EXISTS "${gamewip_changed_absolute}")
                list(APPEND gamewip_changed_cpp_files "${gamewip_changed_absolute}")
            endif()
            set(gamewip_exact_owners)
            set(gamewip_directory_owners)
            set(gamewip_longest_directory -1)

            foreach(gamewip_target IN LISTS gamewip_all_targets)
                get_target_property(gamewip_imported "${gamewip_target}" IMPORTED)
                if(gamewip_imported)
                    continue()
                endif()

                gamewip_validation_target_owns_path("${gamewip_target}" "${gamewip_changed_absolute}" gamewip_ownership)
                if(gamewip_ownership STREQUAL "EXACT")
                    list(APPEND gamewip_exact_owners "${gamewip_target}")
                elseif(gamewip_ownership MATCHES "^[0-9]+$")
                    if(gamewip_ownership GREATER gamewip_longest_directory)
                        set(gamewip_longest_directory "${gamewip_ownership}")
                        set(gamewip_directory_owners "${gamewip_target}")
                    elseif(gamewip_ownership EQUAL gamewip_longest_directory)
                        list(APPEND gamewip_directory_owners "${gamewip_target}")
                    endif()
                endif()
            endforeach()

            if(gamewip_exact_owners)
                list(APPEND gamewip_changed_owners ${gamewip_exact_owners})
            elseif(gamewip_directory_owners)
                list(APPEND gamewip_changed_owners ${gamewip_directory_owners})
            else()
                set(gamewip_full_target_scope ON)
                set(gamewip_all_module_scope ON)
            endif()
        endif()
    endforeach()

    list(REMOVE_DUPLICATES gamewip_changed_owners)

    if(GameWIPTestModules IN_LIST gamewip_changed_owners)
        set(gamewip_all_module_scope ON)
    endif()

    set(gamewip_affected_targets ${gamewip_changed_owners})
    set(gamewip_expand_graph ON)

    # Follow reverse CMake dependencies to affected consumers and test modules.
    while(gamewip_expand_graph)
        set(gamewip_expand_graph OFF)
        foreach(gamewip_candidate IN LISTS gamewip_all_targets)
            if(gamewip_candidate IN_LIST gamewip_affected_targets)
                continue()
            endif()

            get_target_property(gamewip_imported "${gamewip_candidate}" IMPORTED)
            if(gamewip_imported)
                continue()
            endif()

            gamewip_validation_collect_references("${gamewip_candidate}" gamewip_candidate_references)
            foreach(gamewip_reference IN LISTS gamewip_candidate_references)
                if(gamewip_reference IN_LIST gamewip_affected_targets)
                    list(APPEND gamewip_affected_targets "${gamewip_candidate}")
                    set(gamewip_expand_graph ON)
                    break()
                endif()
            endforeach()
        endforeach()
    endwhile()

    if(gamewip_full_target_scope)
        set(gamewip_selected_module_targets ${gamewip_module_targets})
        set(gamewip_build_targets ${gamewip_all_targets})
    else()
        set(gamewip_selected_module_targets)
        foreach(gamewip_target IN LISTS gamewip_affected_targets)
            get_target_property(gamewip_module_name "${gamewip_target}" GAMEWIP_VALIDATION_MODULE_NAME)
            if(gamewip_module_name)
                list(APPEND gamewip_selected_module_targets "${gamewip_target}")
            endif()
        endforeach()

        if(gamewip_all_module_scope)
            set(gamewip_selected_module_targets ${gamewip_module_targets})
        endif()

        set(gamewip_build_targets ${gamewip_affected_targets})
        if(TARGET GameWIPTests)
            list(APPEND gamewip_build_targets GameWIPTests)
        endif()
        if(gamewip_selected_module_targets AND GAMEWIP_ENABLE_STARTUP_TESTS AND TARGET GameWIP)
            list(APPEND gamewip_build_targets GameWIP)
        endif()

        foreach(gamewip_changed_path IN LISTS gamewip_changed_paths)
            if(gamewip_changed_path MATCHES "^game/validation/benchmarks/")
                if(TARGET GameWIPBenchmarks)
                    list(APPEND gamewip_build_targets GameWIPBenchmarks)
                endif()
            endif()
        endforeach()
    endif()

    list(REMOVE_DUPLICATES gamewip_selected_module_targets)
    list(REMOVE_DUPLICATES gamewip_build_targets)
    list(REMOVE_DUPLICATES gamewip_changed_cpp_files)

    if(gamewip_full_target_scope)
        set(gamewip_analysis_targets ${gamewip_all_targets})
    else()
        set(gamewip_analysis_targets ${gamewip_affected_targets} ${gamewip_selected_module_targets})
    endif()
    list(REMOVE_DUPLICATES gamewip_analysis_targets)

    set(gamewip_tidy_sources)
    foreach(gamewip_target IN LISTS gamewip_analysis_targets)
        get_target_property(gamewip_target_type "${gamewip_target}" TYPE)
        if(gamewip_target_type STREQUAL "INTERFACE_LIBRARY")
            continue()
        endif()

        get_target_property(gamewip_target_directory "${gamewip_target}" SOURCE_DIR)
        get_target_property(gamewip_target_sources "${gamewip_target}" SOURCES)
        foreach(gamewip_source IN LISTS gamewip_target_sources)
            if(gamewip_source MATCHES "^\\$<")
                continue()
            endif()

            get_filename_component(gamewip_source_extension "${gamewip_source}" EXT)
            string(TOLOWER "${gamewip_source_extension}" gamewip_source_extension)
            if(NOT gamewip_source_extension MATCHES "^\\.(c|cc|cpp|cxx)$")
                continue()
            endif()

            if(NOT IS_ABSOLUTE "${gamewip_source}")
                cmake_path(
                    ABSOLUTE_PATH gamewip_source
                    BASE_DIRECTORY "${gamewip_target_directory}"
                    NORMALIZE
                    OUTPUT_VARIABLE gamewip_source_absolute
                )
            else()
                cmake_path(NORMAL_PATH gamewip_source OUTPUT_VARIABLE gamewip_source_absolute)
            endif()

            if(EXISTS "${gamewip_source_absolute}")
                list(APPEND gamewip_tidy_sources "${gamewip_source_absolute}")
            endif()
        endforeach()
    endforeach()
    list(REMOVE_DUPLICATES gamewip_tidy_sources)

    set_property(GLOBAL PROPERTY GAMEWIP_VALIDATION_SCOPE_SCOPED "${gamewip_manifest_provided}")
    set_property(GLOBAL PROPERTY GAMEWIP_VALIDATION_SCOPE_FULL "${gamewip_full_scope}")
    set_property(GLOBAL PROPERTY GAMEWIP_VALIDATION_CHANGED_CPP_FILES "${gamewip_changed_cpp_files}")
    set_property(GLOBAL PROPERTY GAMEWIP_VALIDATION_CLANG_TIDY_SOURCES "${gamewip_tidy_sources}")

    if(gamewip_selected_module_targets AND TARGET GameWIPTests)
        target_link_libraries(GameWIPTests PRIVATE ${gamewip_selected_module_targets})
    endif()

    if(TARGET GameWIPValidationSelectedTargets)
        message(FATAL_ERROR "GameWIPValidationSelectedTargets was created before validation scope finalization.")
    endif()
    add_custom_target(GameWIPValidationSelectedTargets)
    foreach(gamewip_target IN LISTS gamewip_build_targets)
        if(TARGET "${gamewip_target}")
            get_target_property(gamewip_target_type "${gamewip_target}" TYPE)
            if(NOT gamewip_target_type STREQUAL "INTERFACE_LIBRARY")
                add_dependencies(GameWIPValidationSelectedTargets "${gamewip_target}")
            endif()
        endif()
    endforeach()

    set(gamewip_selected_tests_path "${CMAKE_BINARY_DIR}/gamewip-validation-tests.txt")
    file(WRITE "${gamewip_selected_tests_path}" "")
    if(GAMEWIP_BUILD_TESTS)
        file(APPEND "${gamewip_selected_tests_path}" "validation.tests.help\n")
        foreach(gamewip_module_target IN LISTS gamewip_selected_module_targets)
            get_target_property(gamewip_module_name "${gamewip_module_target}" GAMEWIP_VALIDATION_MODULE_NAME)
            file(APPEND "${gamewip_selected_tests_path}" "validation.tests.${gamewip_module_name}\n")
        endforeach()

        if(GameWIP IN_LIST gamewip_affected_targets OR gamewip_full_scope)
            if(TARGET GameWIP)
                file(APPEND "${gamewip_selected_tests_path}" "validation.game.version\nvalidation.game.help\n")
            endif()
        endif()
    endif()

    if(gamewip_manifest_provided)
        message(STATUS "GameWIP scoped validation: ${gamewip_selected_module_targets}")
    endif()
endfunction()
