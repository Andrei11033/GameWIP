{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GameWIP: Debug Development",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\build\\dev\\GameWIP.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}\\build\\dev",
      "environment": [{ "name": "PATH", "value": "C:\\MSYS2\\ucrt64\\bin;${env:PATH}" }],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:\\MSYS2\\ucrt64\\bin\\gdb.exe",
      "setupCommands": [
        {
          "description": "Enable GDB pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "GameWIP: Build Development"
    }
  ]
}
