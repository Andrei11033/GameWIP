{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GameWIP: Debug Development",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:gamewip-workflows.developmentExecutable}",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${command:gamewip-workflows.developmentDirectory}",
      "environment": [{ "name": "PATH", "value": "${command:gamewip-workflows.targetRuntimePath}" }],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "${command:gamewip-workflows.debuggerPath}",
      "setupCommands": [
        {
          "description": "Enable GDB pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "GameWIP: Build Development"
    }
  ]
}
