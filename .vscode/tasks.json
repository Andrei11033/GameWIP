{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GameWIP: Configure Development",
      "type": "process",
      "command": "${workspaceFolder}\\gamewip.bat",
      "args": ["configure", "dev"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "silent" },
      "hide": true
    },
    {
      "label": "GameWIP: Build Development",
      "type": "process",
      "command": "${workspaceFolder}\\gamewip.bat",
      "args": ["build", "dev"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"],
      "dependsOn": "GameWIP: Configure Development",
      "dependsOrder": "sequence",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "GameWIP: Run Development",
      "type": "process",
      "command": "${workspaceFolder}\\build\\dev\\GameWIP.exe",
      "options": { "cwd": "${workspaceFolder}\\build\\dev", "env": { "PATH": "C:\\MSYS2\\ucrt64\\bin;${env:PATH}" } },
      "problemMatcher": [],
      "dependsOn": "GameWIP: Build Development",
      "dependsOrder": "sequence",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "GameWIP: Run Development With Startup Tests",
      "type": "process",
      "command": "${workspaceFolder}\\build\\dev\\GameWIP.exe",
      "args": ["--startup-tests"],
      "options": { "cwd": "${workspaceFolder}\\build\\dev", "env": { "PATH": "C:\\MSYS2\\ucrt64\\bin;${env:PATH}" } },
      "problemMatcher": [],
      "dependsOn": "GameWIP: Build Development",
      "dependsOrder": "sequence",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "GameWIP: Configure Tests",
      "type": "process",
      "command": "${workspaceFolder}\\gamewip.bat",
      "args": ["configure", "test"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "silent" },
      "hide": true
    },
    {
      "label": "GameWIP: Build Tests",
      "type": "process",
      "command": "${workspaceFolder}\\gamewip.bat",
      "args": ["build", "test"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"],
      "dependsOn": "GameWIP: Configure Tests",
      "dependsOrder": "sequence",
      "hide": true
    },
    {
      "label": "GameWIP: Test",
      "type": "process",
      "command": "${workspaceFolder}\\gamewip.bat",
      "args": ["test", "test", "-NoBuild"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "dependsOn": "GameWIP: Build Tests",
      "dependsOrder": "sequence",
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "GameWIP: Benchmark",
      "type": "process",
      "command": "${workspaceFolder}\\gamewip.bat",
      "args": ["benchmark", "run"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "GameWIP: Profile",
      "type": "shell",
      "command": "cmake --preset profile; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; cmake --build --preset profile --parallel; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; $profiler = 'C:\\MSYS2\\GameWIPTools\\tools\\tracy\\tracy-profiler.exe'; if (!(Test-Path -LiteralPath $profiler)) { throw 'Matching Tracy profiler tools are missing; run setup.bat profiler.' }; if ($null -eq (Get-Process -Name tracy-profiler -ErrorAction SilentlyContinue)) { Start-Process -FilePath $profiler -WorkingDirectory (Split-Path $profiler) }; & '${workspaceFolder}\\build\\profile\\GameWIP.exe'",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PATH": "C:\\MSYS2\\ucrt64\\bin;${env:PATH}" },
        "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] }
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "GameWIP: Profile Startup Tests",
      "type": "shell",
      "command": "cmake --preset profile; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; cmake --build --preset profile --parallel; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; $profiler = 'C:\\MSYS2\\GameWIPTools\\tools\\tracy\\tracy-profiler.exe'; if (!(Test-Path -LiteralPath $profiler)) { throw 'Matching Tracy profiler tools are missing; run setup.bat profiler.' }; if ($null -eq (Get-Process -Name tracy-profiler -ErrorAction SilentlyContinue)) { Start-Process -FilePath $profiler -WorkingDirectory (Split-Path $profiler) }; & '${workspaceFolder}\\build\\profile\\GameWIP.exe' --startup-tests",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PATH": "C:\\MSYS2\\ucrt64\\bin;${env:PATH}" },
        "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] }
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "GameWIP: Coverage",
      "type": "process",
      "command": "${workspaceFolder}\\gamewip.bat",
      "args": ["coverage"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "GameWIP: Address Sanitizer",
      "type": "process",
      "command": "${workspaceFolder}\\gamewip.bat",
      "args": ["asan"],
      "options": { "cwd": "${workspaceFolder}", "env": { "PATH": "C:\\MSYS2\\clang64\\bin;${env:PATH}" } },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "GameWIP: Analyze",
      "type": "process",
      "command": "${workspaceFolder}\\gamewip.bat",
      "args": ["analyze"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "GameWIP: Quality Check",
      "type": "process",
      "command": "${workspaceFolder}\\gamewip.bat",
      "args": ["quality", "check"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "GameWIP: Tools Status",
      "type": "process",
      "command": "${workspaceFolder}\\gamewip.bat",
      "args": ["tools", "status"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "GameWIP: Documentation",
      "type": "process",
      "command": "${workspaceFolder}\\gamewip.bat",
      "args": ["docs"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "GameWIP: Run Release",
      "type": "shell",
      "command": "& '${workspaceFolder}\\gamewip.bat' build release; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; & '${workspaceFolder}\\build\\release\\GameWIP.exe'",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PATH": "C:\\MSYS2\\ucrt64\\bin;${env:PATH}" },
        "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] }
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
