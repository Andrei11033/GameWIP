{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GameWIP: Configure Development",
      "type": "process",
      "command": "${workspaceFolder}\\gamewip.bat",
      "args": ["config", "dev"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent"
      },
      "hide": true
    },
    {
      "label": "GameWIP: Build Development",
      "type": "process",
      "command": "${workspaceFolder}\\gamewip.bat",
      "args": ["build", "dev"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": "GameWIP: Configure Development",
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "GameWIP: Run Development",
      "type": "process",
      "command": "${workspaceFolder}\\build\\dev\\GameWIP.exe",
      "options": {
        "cwd": "${workspaceFolder}\\build\\dev",
        "env": {
          "PATH": "C:\\MSYS2\\ucrt64\\bin;${env:PATH}"
        }
      },
      "problemMatcher": [],
      "dependsOn": "GameWIP: Build Development",
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "GameWIP: Run Development With Startup Tests",
      "type": "process",
      "command": "${workspaceFolder}\\build\\dev\\GameWIP.exe",
      "args": ["--startup-tests"],
      "options": {
        "cwd": "${workspaceFolder}\\build\\dev",
        "env": {
          "PATH": "C:\\MSYS2\\ucrt64\\bin;${env:PATH}"
        }
      },
      "problemMatcher": [],
      "dependsOn": "GameWIP: Build Development",
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "GameWIP: Configure Tests",
      "type": "process",
      "command": "${workspaceFolder}\\gamewip.bat",
      "args": ["config", "test"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent"
      },
      "hide": true
    },
    {
      "label": "GameWIP: Build Tests",
      "type": "process",
      "command": "${workspaceFolder}\\gamewip.bat",
      "args": ["build", "test"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": "GameWIP: Configure Tests",
      "dependsOrder": "sequence",
      "hide": true
    },
    {
      "label": "GameWIP: Test",
      "type": "process",
      "command": "${workspaceFolder}\\gamewip.bat",
      "args": ["test", "test", "-SkipBuild"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": "GameWIP: Build Tests",
      "dependsOrder": "sequence",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "GameWIP: Benchmark",
      "type": "process",
      "command": "${workspaceFolder}\\gamewip.bat",
      "args": ["bench", "run"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "GameWIP: Profile",
      "type": "shell",
      "command": "cmake --preset profile; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; cmake --build --preset profile --parallel; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; $profiler = 'C:\\MSYS2\\GameWIPTools\\tools\\tracy\\tracy-profiler.exe'; if (!(Test-Path -LiteralPath $profiler)) { throw 'Matching Tracy profiler tools are missing; run setup.bat profiler.' }; if ($null -eq (Get-Process -Name tracy-profiler -ErrorAction SilentlyContinue)) { Start-Process -FilePath $profiler -WorkingDirectory (Split-Path $profiler) }; & '${workspaceFolder}\\build\\profile\\GameWIP.exe'",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\MSYS2\\ucrt64\\bin;${env:PATH}"
        },
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-Command"]
        }
      },
      "problemMatcher": []
    },
    {
      "label": "GameWIP: Profile Startup Tests",
      "type": "shell",
      "command": "cmake --preset profile; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; cmake --build --preset profile --parallel; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; $profiler = 'C:\\MSYS2\\GameWIPTools\\tools\\tracy\\tracy-profiler.exe'; if (!(Test-Path -LiteralPath $profiler)) { throw 'Matching Tracy profiler tools are missing; run setup.bat profiler.' }; if ($null -eq (Get-Process -Name tracy-profiler -ErrorAction SilentlyContinue)) { Start-Process -FilePath $profiler -WorkingDirectory (Split-Path $profiler) }; Push-Location '${workspaceFolder}\\build\\profile'; & '.\\GameWIP.exe' --startup-tests; $exitCode = $LASTEXITCODE; Pop-Location; exit $exitCode",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\MSYS2\\ucrt64\\bin;${env:PATH}"
        },
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-Command"]
        }
      },
      "problemMatcher": []
    },
    {
      "label": "GameWIP: Coverage",
      "type": "process",
      "command": "${workspaceFolder}\\gamewip.bat",
      "args": ["cov"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "GameWIP: Address Sanitizer",
      "type": "process",
      "command": "${workspaceFolder}\\gamewip.bat",
      "args": ["asan"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\MSYS2\\clang64\\bin;${env:PATH}"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "GameWIP: Undefined Behavior Sanitizer",
      "type": "process",
      "command": "${workspaceFolder}\\gamewip.bat",
      "args": ["ubsan"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\MSYS2\\clang64\\bin;${env:PATH}"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "GameWIP: Analyze",
      "type": "process",
      "command": "${workspaceFolder}\\gamewip.bat",
      "args": ["analyze"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "GameWIP: Quality Check",
      "type": "process",
      "command": "${workspaceFolder}\\gamewip.bat",
      "args": ["quality", "check"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "GameWIP: Tools Status",
      "type": "process",
      "command": "${workspaceFolder}\\gamewip.bat",
      "args": ["tool", "status"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "GameWIP: Documentation",
      "type": "process",
      "command": "${workspaceFolder}\\gamewip.bat",
      "args": ["doc"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "GameWIP: Run Release",
      "type": "shell",
      "command": "& '${workspaceFolder}\\gamewip.bat' build release; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; & '${workspaceFolder}\\build\\release\\GameWIP.exe'",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\MSYS2\\ucrt64\\bin;${env:PATH}"
        },
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-Command"]
        }
      },
      "problemMatcher": []
    }
  ]
}
