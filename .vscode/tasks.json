{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                ".",
                "-B",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "C:\\MSYS2\\ucrt64\\bin;${env:PATH}"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "CMake Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "C:\\MSYS2\\ucrt64\\bin;${env:PATH}"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": "CMake Configure"
        },
        {
            "label": "Run GameWIP",
            "type": "shell",
            "command": "${workspaceFolder}\\build\\GameWIP.exe",
            "options": {
                "cwd": "${workspaceFolder}\\build",
                "env": {
                    "PATH": "C:\\MSYS2\\ucrt64\\bin;${env:PATH}"
                }
            },
            "problemMatcher": [],
            "dependsOn": "CMake Build"
        },
        {
            "label": "Verify GameWIP",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "$ErrorActionPreference = 'Stop'; & '${workspaceFolder}\\build\\GameWIP.exe' both info; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; Write-Host 'Verification passed.'"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\build",
                "env": {
                    "PATH": "C:\\MSYS2\\ucrt64\\bin;${env:PATH}"
                }
            },
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "dependsOn": "CMake Build"
        },
        {
            "label": "CMake Configure Release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                ".",
                "-B",
                "build-release",
                "-G",
                "MinGW Makefiles",
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "C:\\MSYS2\\ucrt64\\bin;${env:PATH}"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "CMake Build Release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build-release"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "C:\\MSYS2\\ucrt64\\bin;${env:PATH}"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": "CMake Configure Release"
        }
    ]
}