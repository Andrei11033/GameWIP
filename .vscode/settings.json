{
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/dev/compile_commands.json",
  "C_Cpp.default.compilerPath": "C:/MSYS2/ucrt64/bin/g++.exe",
  "C_Cpp.default.cppStandard": "c++23",
  "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",
  "C_Cpp.codeAnalysis.clangTidy.enabled": false,
  "C_Cpp.codeAnalysis.runAutomatically": false,
  "C_Cpp.codeAnalysis.exclude": {
    "**/*": true
  },
  "C_Cpp.clang_format_path": "C:/MSYS2/ucrt64/bin/clang-format.exe",
  "C_Cpp.clang_format_style": "file",
  "clang-format.executable": "C:/MSYS2/ucrt64/bin/clang-format.exe",
  "editor.formatOnSave": true,
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/build/gamewip/tools/managed/python",
  "python-envs.workspaceSearchPaths": ["./build/gamewip/tools/managed/python"],
  "python-envs.pythonProjects": [
    {
      "path": ".",
      "envManager": "ms-python.python:venv",
      "packageManager": "ms-python.python:pip"
    }
  ],
  "python.analysis.exclude": ["**/build", "**/external"],
  "python.testing.unittestEnabled": true,
  "python.testing.pytestEnabled": false,
  "python.testing.unittestArgs": ["-v", "-s", ".github/scripts", "-p", "test_*.py"],
  "ruff.configuration": "${workspaceFolder}/config/quality/ruff.toml",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true
  }
}
