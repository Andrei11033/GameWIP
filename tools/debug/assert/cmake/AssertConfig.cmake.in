# The interface-only package has no runtime dependencies.
@PACKAGE_INIT@

if(@ASSERT_RUNTIME_TARGET_ENABLED@)
    include(CMakeFindDependencyMacro)
    find_dependency(GameWIPApplication @PROJECT_VERSION@ EXACT CONFIG)
    find_dependency(Logger @PROJECT_VERSION@ EXACT CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/AssertTargets.cmake")
