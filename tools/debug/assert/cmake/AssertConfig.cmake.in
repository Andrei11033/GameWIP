# The installed package imports Assert and exposes explicit executable manifest attachment.
@PACKAGE_INIT@

# Resolve package-owned resources before dependency discovery. CMake versions
# before 3.30 may let a nested find_dependency() overwrite PACKAGE_PREFIX_DIR.
set(Assert_COMMON_CONTROLS_MANIFEST "@PACKAGE_CMAKE_INSTALL_DATADIR@/Assert/common_controls_v6.manifest")
set(Assert_COMMON_CONTROLS_RC_TEMPLATE "@PACKAGE_CMAKE_INSTALL_DATADIR@/Assert/common_controls_v6.rc.in")

include(CMakeFindDependencyMacro)

if(@ASSERT_RUNTIME_TARGET_ENABLED@)
    find_dependency(Logger @PROJECT_VERSION@ EXACT CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/AssertTargets.cmake")

# Configures a build-directory resource that points at the installed manifest.
function(_internal_assert_configure_common_controls_v6 output_variable)
    if(NOT WIN32)
        return()
    endif()

    # Both installed inputs are required before a consumer resource can be generated.
    if(NOT EXISTS "${Assert_COMMON_CONTROLS_MANIFEST}")
        message(FATAL_ERROR "Assert Common Controls v6 manifest was not found: ${Assert_COMMON_CONTROLS_MANIFEST}")
    endif()

    if(NOT EXISTS "${Assert_COMMON_CONTROLS_RC_TEMPLATE}")
        message(FATAL_ERROR "Assert Common Controls v6 resource template was not found: ${Assert_COMMON_CONTROLS_RC_TEMPLATE}")
    endif()

    # The generated resource belongs to the consumer build and points at the installed manifest.
    set(ASSERT_INTERNAL_COMMON_CONTROLS_MANIFEST "${Assert_COMMON_CONTROLS_MANIFEST}")
    set(Assert_COMMON_CONTROLS_RC "${CMAKE_CURRENT_BINARY_DIR}/assert_common_controls_v6.rc")
    configure_file("${Assert_COMMON_CONTROLS_RC_TEMPLATE}" "${Assert_COMMON_CONTROLS_RC}" @ONLY)

    set(${output_variable} "${Assert_COMMON_CONTROLS_RC}" PARENT_SCOPE)
endfunction()

# The helper attaches the resource explicitly, including for targets that link Assert: linking alone
# does not attach it. The target property makes repeated calls harmless. Applications
# using Desktop's combined manifest must not also attach this resource.
function(assert_enable_common_controls_v6 target_name)
    if(NOT WIN32)
        return()
    endif()

    if(NOT TARGET "${target_name}")
        message(FATAL_ERROR "assert_enable_common_controls_v6 target does not exist: ${target_name}")
    endif()

    _internal_assert_configure_common_controls_v6(Assert_COMMON_CONTROLS_RC)

    # Attachment is tracked on the target so repeated helper calls do not duplicate the resource.
    get_property(Assert_COMMON_CONTROLS_ATTACHED TARGET "${target_name}" PROPERTY ASSERT_INTERNAL_COMMON_CONTROLS_ATTACHED)
    if(Assert_COMMON_CONTROLS_ATTACHED)
        return()
    endif()

    target_sources("${target_name}" PRIVATE "${Assert_COMMON_CONTROLS_RC}")

    set_property(TARGET "${target_name}" PROPERTY ASSERT_INTERNAL_COMMON_CONTROLS_ATTACHED TRUE)
endfunction()
