@PACKAGE_INIT@

# Status defines TestSupport's public results; Unicode owns its text semantics.
include(CMakeFindDependencyMacro)
find_dependency(Status @PROJECT_VERSION@ EXACT CONFIG)
find_dependency(Unicode @PROJECT_VERSION@ EXACT CONFIG)

# The exported target contains the complete public package interface.
include("${CMAKE_CURRENT_LIST_DIR}/TestSupportTargets.cmake")
