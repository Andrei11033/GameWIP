{
  "config": {
    "default": true,
    "MD013": {
      "line_length": 150,
      "code_blocks": false,
      "tables": false,
    },
    "MD024": { "siblings_only": true },
    "MD025": false,
    "MD033": false,
    "MD041": false,
  },
  "globs": ["**/*.md", "!build/**", "!external/**"],
  "ignores": ["docs/releases/**"],
}
