# yaml-language-server: $schema=https://raw.githubusercontent.com/BlankSpruce/gersemi/0.28.1/gersemi/configuration.schema.json
definitions:
  - cmake
  - game/validation/benchmarks/CMakeLists.txt
  - game/validation/public_headers/CMakeLists.txt
  - game/validation/tests/CMakeLists.txt
  - tools/debug/assert
disable_formatting: false
extensions: []
indent: 4
line_length: 150
list_expansion: favour-inlining
sort_order: case-sensitive
unsafe: false
warn_about_unknown_commands: true
