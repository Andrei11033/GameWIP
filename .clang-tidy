---
CheckOptions:
  bugprone-suspicious-stringview-data-usage.AllowedCallees: 'MultiByteToWideChar;WideCharToMultiByte'
  modernize-use-nullptr.NullMacros: 'NULL'
  modernize-use-to-underlying.ImpreciseCasts: 'Ignore'

  readability-identifier-naming.GlobalConstexprVariableCase: 'CamelCase'
  readability-identifier-naming.GlobalConstexprVariablePrefix: 'k'
  readability-identifier-naming.GlobalConstantCase: 'CamelCase'
  readability-identifier-naming.GlobalConstantPrefix: 'k'

  readability-identifier-naming.ClassConstexprCase: 'camelBack'
  readability-identifier-naming.ClassConstexprPrefix: ''
  readability-identifier-naming.ClassConstantCase: 'camelBack'
  readability-identifier-naming.ClassConstantPrefix: ''

Checks: >
  -*,
  clang-analyzer-*,
  bugprone-*,
  concurrency-*,
  performance-*,
  portability-*,

  misc-definitions-in-headers,
  misc-misplaced-const,
  misc-new-delete-overloads,
  misc-non-copyable-objects,
  misc-redundant-expression,
  misc-static-assert,
  misc-unconventional-assign-operator,

  modernize-deprecated-headers,
  modernize-loop-convert,
  modernize-make-shared,
  modernize-make-unique,
  modernize-pass-by-value,
  modernize-redundant-void-arg,
  modernize-replace-auto-ptr,
  modernize-shrink-to-fit,
  modernize-unary-static-assert,
  modernize-use-bool-literals,
  modernize-use-default-member-init,
  modernize-use-equals-default,
  modernize-use-equals-delete,
  modernize-use-noexcept,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-to-underlying,
  modernize-use-using,

  readability-avoid-const-params-in-decls,
  readability-braces-around-statements,
  readability-container-contains,
  readability-container-size-empty,
  readability-duplicate-include,
  readability-identifier-naming,
  readability-inconsistent-declaration-parameter-name,
  readability-misleading-indentation,
  readability-redundant-*,
  readability-simplify-boolean-expr,
  readability-static-accessed-through-instance,

  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -bugprone-narrowing-conversions,
  -bugprone-throwing-static-initialization,
  -bugprone-unsafe-functions,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  -concurrency-mt-unsafe,
  -misc-misplaced-const,
  -misc-redundant-expression,
  -modernize-loop-convert,
  -performance-enum-size,
  -performance-no-automatic-move,
  -performance-no-int-to-ptr,
  -portability-avoid-pragma-once,
  -readability-redundant-inline-specifier,
  -readability-redundant-member-init,
  -readability-redundant-parentheses
ExcludeHeaderFilterRegex: '.*[\\/](external|build)[\\/].*'
FormatStyle: file
HeaderFilterRegex: '.*[\\/](foundation|tools|engine|game)[\\/].*'
SystemHeaders: false
WarningsAsErrors: '*'
...
